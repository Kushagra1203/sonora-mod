+/// Creates the graphics context and the surface for a window, with Vulkan first and
+/// OpenGL as the fallback for a machine where Vulkan cannot make a surface.
+#[cfg(not(target_family = "wasm"))]
+fn create_context<W>(
+    window: &W,
+    raw_window_handle: raw_window_handle::RawWindowHandle,
+    compositor_gpu: Option<CompositorGpuHint>,
+) -> Result<(WgpuContext, wgpu::Surface<'static>)>
+where
+    W: HasWindowHandle + HasDisplayHandle + std::fmt::Debug + Send + Sync + Clone + 'static,
+{
+    let mut failure = None;
+    for vulkan_only in [true, false] {
+        let instance = match vulkan_only {
+            true => WgpuContext::instance_vulkan(Some(Box::new(window.clone()))),
+            false => WgpuContext::instance(Some(Box::new(window.clone()))),
+        };
+        let surface = match create_surface(&instance, raw_window_handle) {
+            Ok(surface) => surface,
+            Err(error) => {
+                failure = Some(error);
+                continue;
+            }
+        };
+        match WgpuContext::new(instance, &surface, compositor_gpu) {
+            Ok(context) => return Ok((context, surface)),
+            Err(error) => failure = Some(error),
+        }
+    }
+
+    Err(failure.unwrap_or_else(|| anyhow::anyhow!("no graphics backend could make a surface")))
+}
 
