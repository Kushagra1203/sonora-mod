+    /// A browse for a page of the account's own, which Google hands over only when the request
+    /// names the account it is made for. The listening history is such a page: without the
+    /// name it answers with the signed-out history, which holds nothing.
+    pub async fn browse_account(&self, browse_id: &str) -> Result<Value> {
+        let Some(account) = self.account_id().await else {
+            bail!("the session has no account to name");
+        };
+        self.execute(
+            "browse",
+            Client::Music,
+            json!({
+                "browseId": browse_id,
+                "context": { "user": { "onBehalfOfUser": account } },
+            }),
+        )
+        .await
+    }
