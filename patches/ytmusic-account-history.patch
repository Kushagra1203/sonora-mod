+    /// The account the session acts for, as `context.user.onBehalfOfUser` names it. Google hands
+    /// over the account's own pages only when a request names the account it is made for, so
+    /// this is what the listening history needs. `None` for a guest session, which has no
+    /// account and no history to read.
+    pub async fn account_id(&self) -> Option<String> {
+        if !self.is_authenticated() {
+            return None;
+        }
+        let found = self.data_sync_id().await?;
+        // YouTube publishes the id as `account||identity`, where the second half is the
+        // identity the session acts for; a plain account leaves it empty.
+        let identity = match found.split_once("||") {
+            Some((_, after)) if !after.is_empty() => after,
+            Some((before, _)) => before,
+            None => found.as_str(),
+        };
+        (!identity.is_empty()).then(|| identity.to_owned())
+    }
